# Copy to .env.local and fill in. Never commit .env.local.
# Claude (AI brief, Ask, photo/ledger reading). Without it Pedhi falls back to rule-based answers.
ANTHROPIC_API_KEY=
# PEDHI_MODEL=claude-opus-5-5
# PEDHI_FAST_MODEL=claude-haiku-5-5

# WhatsApp Cloud API (Meta). Without these the in-app simulator is used.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Shared secret for /api/cron/reminders (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# Public https address, used in statement links (e.g. your tunnel or Vercel URL).
PUBLIC_URL=

# Hosted database (Turso). Leave empty to use the local pedhi.db file.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
